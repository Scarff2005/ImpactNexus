# Normalise text to LF in the repository, regardless of the machine that clones it.
* text=auto eol=lf

# Binary documents: never touched by line-ending conversion or diff heuristics.
*.docx binary
*.pptx binary
*.xlsx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.zip  binary
*.drawio binary

# Shell scripts keep LF so they run on any machine.
*.sh   text eol=lf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
