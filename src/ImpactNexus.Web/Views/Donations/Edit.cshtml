@model Donation
@{
    ViewData["Title"] = "Edit contribution";
    var companies = (List<Company>)ViewBag.Companies;
    var activities = (List<CsrActivity>)ViewBag.Activities;
    var investors = (List<ApplicationUser>)ViewBag.Investors;
}
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DonorName" class="form-label"></label>
                    <input asp-for="DonorName" class="form-control" />
                    <span asp-validation-for="DonorName" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DonorUserId" class="form-label"></label>
                    <select asp-for="DonorUserId" class="form-select">
                        <option value="">Not linked to a platform account</option>
                        @foreach (var investor in investors)
                        {
                            <option value="@investor.Id">@investor.FullName (@investor.Email)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanyId" class="form-label"></label>
                    <select asp-for="CompanyId" class="form-select">
                        @foreach (var company in companies)
                        {
                            <option value="@company.Id">@company.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="CsrActivityId" class="form-label"></label>
                    <select asp-for="CsrActivityId" class="form-select">
                        <option value="">Unallocated</option>
                        @foreach (var activity in activities)
                        {
                            <option value="@activity.Id">@activity.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Amount" class="field-validation-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DonatedOn" class="form-label"></label>
                    <input asp-for="DonatedOn" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        @foreach (var status in Enum.GetValues<DonationStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Reference" class="form-label"></label>
                    <input asp-for="Reference" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
