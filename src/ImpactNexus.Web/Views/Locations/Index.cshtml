@model List<ImpactNexus.Web.Models.Location>
@{
    ViewData["Title"] = "Locations";
    var towns = (List<Town>)ViewBag.Towns;
}
<div class="page-actions">
    <a class="btn btn-primary" asp-action="Create">Add location</a>
    <form method="get" class="filters mb-0 ms-auto">
        <select name="townId" class="form-select form-select-sm">
            <option value="">All towns</option>
            @foreach (var town in towns)
            {
                <option value="@town.Id" selected="@(ViewBag.TownId as int? == town.Id)">@town.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </form>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Location</th><th>Address</th><th>Town</th><th>Province</th><th></th></tr></thead>
            <tbody>
            @foreach (var location in Model)
            {
                <tr>
                    <td>@location.Name</td>
                    <td>@(location.AddressLine ?? "—")</td>
                    <td>@location.Town?.Name</td>
                    <td>@location.Town?.Province?.Name</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@location.Id">Edit</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="empty-state">No locations recorded.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
