@model ImpactNexus.Web.Models.Location
@{
    ViewData["Title"] = "Delete location";
}
<div class="card">
    <div class="card-body">
        <p>Delete <strong>@Model.Name</strong>? Locations linked to activities or programmes cannot be deleted.</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this location?">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Delete location</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
