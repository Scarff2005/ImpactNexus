@model VolunteerHour
@{
    ViewData["Title"] = "Edit volunteer hours";
    var programmes = (List<VolunteerProgramme>)ViewBag.Programmes;
    var activities = (List<CsrActivity>)ViewBag.Activities;
}
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="VolunteerProgrammeId" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Volunteer</label>
                    <input class="form-control" value="@Model.User?.FullName" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Programme</label>
                    <input class="form-control" value="@Model.VolunteerProgramme?.Name" readonly />
                </div>
                <div class="col-md-6">
                    <label asp-for="CsrActivityId" class="form-label"></label>
                    <select asp-for="CsrActivityId" class="form-select">
                        <option value="">Not linked</option>
                        @foreach (var activity in activities)
                        {
                            <option value="@activity.Id">@activity.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Hours" class="form-label"></label>
                    <input asp-for="Hours" class="form-control" type="number" step="0.25" min="0.25" max="24" />
                    <span asp-validation-for="Hours" class="field-validation-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <div class="form-check mt-3">
                        <input asp-for="Approved" class="form-check-input" />
                        <label asp-for="Approved" class="form-check-label">Approved</label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
