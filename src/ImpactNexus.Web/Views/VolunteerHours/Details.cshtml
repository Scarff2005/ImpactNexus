@model VolunteerHour
@{
    ViewData["Title"] = "Volunteer hours";
    bool canManage = (bool)ViewBag.CanManage;
}
<div class="page-actions">
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    @if (canManage)
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-danger ms-auto" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    }
</div>
<div class="card">
    <div class="card-body">
        <dl class="detail-list">
            <dt>Volunteer</dt><dd>@(Model.User?.FullName ?? "—")</dd>
            <dt>Programme</dt><dd>@Model.VolunteerProgramme?.Name</dd>
            <dt>Company</dt><dd>@Model.VolunteerProgramme?.Company?.Name</dd>
            <dt>Activity</dt><dd>@(Model.CsrActivity?.Title ?? "—")</dd>
            <dt>Date</dt><dd>@Model.Date.ToString("dd MMM yyyy")</dd>
            <dt>Hours</dt><dd>@Model.Hours.ToString("N1")</dd>
            <dt>Status</dt><dd><span class="badge-status @(Model.Approved ? "status-approved" : "status-submitted")">@(Model.Approved ? "Approved" : "Pending")</span></dd>
            <dt>Notes</dt><dd>@(Model.Notes ?? "—")</dd>
            <dt>Logged</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
        </dl>
    </div>
</div>
