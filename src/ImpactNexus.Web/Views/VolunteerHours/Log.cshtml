@model VolunteerHour
@{
    ViewData["Title"] = "Log volunteer hours";
    var programmes = (List<VolunteerProgramme>)ViewBag.Programmes;
    var activities = (List<CsrActivity>)ViewBag.Activities;
}
<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><h2>Hours worked</h2></div>
            <div class="card-body">
                @if (programmes.Count == 0)
                {
                    <p class="text-muted mb-0">No active volunteer programmes are available to log against.</p>
                }
                else
                {
                    <form asp-action="Log" method="post">
                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="VolunteerProgrammeId" class="form-label"></label>
                                <select asp-for="VolunteerProgrammeId" class="form-select">
                                    <option value="">Select programme</option>
                                    @foreach (var programme in programmes)
                                    {
                                        <option value="@programme.Id">@programme.Name · @programme.Company?.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="VolunteerProgrammeId" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CsrActivityId" class="form-label"></label>
                                <select asp-for="CsrActivityId" class="form-select">
                                    <option value="">Not linked</option>
                                    @foreach (var activity in activities)
                                    {
                                        <option value="@activity.Id">@activity.Title</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Hours" class="form-label"></label>
                                <input asp-for="Hours" class="form-control" type="number" step="0.25" min="0.25" max="24" />
                                <span asp-validation-for="Hours" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Date" class="form-label"></label>
                                <input asp-for="Date" class="form-control" />
                                <span asp-validation-for="Date" class="field-validation-error"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Notes" class="form-label"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">Submit for approval</button>
                            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
