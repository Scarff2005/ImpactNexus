@model VolunteerHour
@{
    ViewData["Title"] = "Record volunteer hours";
    var programmes = (List<VolunteerProgramme>)ViewBag.Programmes;
    var activities = (List<CsrActivity>)ViewBag.Activities;
    var volunteers = (List<ApplicationUser>)ViewBag.Volunteers;
}
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="VolunteerProgrammeId" class="form-label"></label>
                    <select asp-for="VolunteerProgrammeId" class="form-select">
                        <option value="">Select programme</option>
                        @foreach (var programme in programmes)
                        {
                            <option value="@programme.Id">@programme.Name</option>
                        }
                    </select>
                    <span asp-validation-for="VolunteerProgrammeId" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UserId" class="form-label"></label>
                    <select asp-for="UserId" class="form-select">
                        <option value="">Select volunteer</option>
                        @foreach (var volunteer in volunteers)
                        {
                            <option value="@volunteer.Id">@volunteer.FullName (@volunteer.Email)</option>
                        }
                    </select>
                    <span asp-validation-for="UserId" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CsrActivityId" class="form-label"></label>
                    <select asp-for="CsrActivityId" class="form-select">
                        <option value="">Not linked</option>
                        @foreach (var activity in activities)
                        {
                            <option value="@activity.Id">@activity.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Hours" class="form-label"></label>
                    <input asp-for="Hours" class="form-control" type="number" step="0.25" min="0.25" max="24" />
                    <span asp-validation-for="Hours" class="field-validation-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <div class="form-check mt-4">
                        <input asp-for="Approved" class="form-check-input" />
                        <label asp-for="Approved" class="form-check-label">Approved</label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Record hours</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
