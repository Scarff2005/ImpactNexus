@model PagedList<VolunteerHour>
@{
    ViewData["Title"] = "Volunteer hours";
    bool canManage = (bool)ViewBag.CanManage;
    bool canLog = (bool)ViewBag.CanLog;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
<div class="page-actions">
    @if (canLog)
    {
        <a class="btn btn-primary" asp-action="Log">Log hours</a>
    }
    @if (canManage)
    {
        <a class="btn btn-outline-primary" asp-action="Create">Record hours</a>
    }
    <div class="ms-auto text-muted" style="font-size:.84rem;">
        Total: <strong>@(((decimal)ViewBag.TotalHours).ToString("N1"))</strong> h ·
        Pending: <strong>@(((decimal)ViewBag.PendingHours).ToString("N1"))</strong> h
    </div>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Date</th><th>Volunteer</th><th>Programme</th><th>Activity</th><th>Hours</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var hour in Model.Items)
            {
                <tr>
                    <td>@hour.Date.ToString("dd MMM yyyy")</td>
                    <td>@(hour.User?.FullName ?? "—")</td>
                    <td>@hour.VolunteerProgramme?.Name</td>
                    <td>@(hour.CsrActivity?.Title ?? "—")</td>
                    <td>@hour.Hours.ToString("N1")</td>
                    <td><span class="badge-status @(hour.Approved ? "status-approved" : "status-submitted")">@(hour.Approved ? "Approved" : "Pending")</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@hour.Id">Open</a>
                        @if (canManage)
                        {
                            <form asp-action="Approve" asp-route-id="@hour.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(hour.Approved ? "Withdraw" : "Approve")</button>
                            </form>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@hour.Id">Edit</a>
                        }
                        else if (!canManage && hour.UserId == currentUserId)
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@hour.Id">Details</a>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="empty-state"><strong>No volunteer hours</strong>Hours appear once logged and approved.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="PagerModel.From(Model)" />
</div>
