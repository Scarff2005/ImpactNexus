@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="card">
    <div class="card-body">
        <h2 class="section-title">An error occurred</h2>
        <p class="text-muted mb-3">The request could not be completed. No sensitive details are displayed here.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="mb-0"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-outline-secondary mt-3" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
    </div>
</div>
