@model CsrActivity
@{
    ViewData["Title"] = Model.Title;
    ViewData["Subtitle"] = Model.Company?.Name + " · CSR activity";
}
<div class="page-actions">
    <a class="btn btn-outline-secondary" asp-action="Index">Back to activities</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-outline-danger ms-auto" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
</div>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2>Activity</h2>
                <span class="badge-status status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span>
            </div>
            <div class="card-body">
                <p style="font-size:.9rem;">@Model.Description</p>
                @if (!string.IsNullOrWhiteSpace(Model.Objectives))
                {
                    <h3 class="section-title mt-3" style="font-size:.85rem;">Objectives</h3>
                    <p class="mb-0" style="font-size:.9rem;">@Model.Objectives</p>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h2>Contributions linked to this activity</h2></div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Donor</th><th>Date</th><th>Status</th><th class="text-end">Amount</th></tr></thead>
                    <tbody>
                    @foreach (var donation in Model.Donations.OrderByDescending(d => d.DonatedOn))
                    {
                        <tr>
                            <td><a asp-controller="Donations" asp-action="Details" asp-route-id="@donation.Id">@donation.DonorName</a></td>
                            <td>@donation.DonatedOn.ToString("dd MMM yyyy")</td>
                            <td><span class="badge-status status-@donation.Status.ToString().ToLowerInvariant()">@donation.Status</span></td>
                            <td class="text-end">@donation.Amount.ToString("C0", Money.Zar)</td>
                        </tr>
                    }
                    @if (Model.Donations.Count == 0)
                    {
                        <tr><td colspan="4" class="empty-state">No contributions linked yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h2>Details</h2></div>
            <div class="card-body">
                <dl class="detail-list">
                    <dt>Company</dt><dd>@Model.Company?.Name</dd>
                    <dt>Location</dt><dd>@(Model.Location?.Name ?? "—")</dd>
                    <dt>Town</dt><dd>@(Model.Location?.Town?.Name ?? "—")</dd>
                    <dt>Start</dt><dd>@Model.StartDate.ToString("dd MMM yyyy")</dd>
                    <dt>End</dt><dd>@(Model.EndDate?.ToString("dd MMM yyyy") ?? "Open ended")</dd>
                    <dt>Budget</dt><dd>@Model.Budget.ToString("C0", Money.Zar)</dd>
                    <dt>Impact indicator</dt><dd>@(Model.ImpactIndicator ?? "—")</dd>
                    <dt>Project lead</dt><dd>@(Model.Manager?.FullName ?? "—")</dd>
                    <dt>Created</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
