@model VolunteerProgramme
@{
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = Model.Company?.Name + " · volunteer programme";
    bool canManage = (bool)ViewBag.CanManage;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var visibleHours = canManage
        ? Model.VolunteerHours.OrderByDescending(v => v.Date).ToList()
        : Model.VolunteerHours.Where(v => v.UserId == currentUserId).OrderByDescending(v => v.Date).ToList();
}
<div class="page-actions">
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    @if (canManage)
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-danger ms-auto" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    }
    else
    {
        <a class="btn btn-primary ms-auto" asp-controller="VolunteerHours" asp-action="Log">Log hours</a>
    }
</div>
<div class="row g-4">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h2>Programme</h2></div>
            <div class="card-body">
                <p style="font-size:.9rem;">@Model.Description</p>
                <dl class="detail-list">
                    <dt>Company</dt><dd>@Model.Company?.Name</dd>
                    <dt>Location</dt><dd>@(Model.Location?.Name ?? "—")</dd>
                    <dt>Start</dt><dd>@Model.StartDate.ToString("dd MMM yyyy")</dd>
                    <dt>End</dt><dd>@(Model.EndDate?.ToString("dd MMM yyyy") ?? "Open ended")</dd>
                    <dt>Status</dt><dd><span class="badge-status status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></dd>
                    <dt>Total hours</dt><dd>@Model.VolunteerHours.Sum(v => v.Hours).ToString("N1")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><h2>@(canManage ? "Logged hours" : "My logged hours")</h2></div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Date</th><th>Volunteer</th><th>Hours</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var hour in visibleHours)
                    {
                        <tr>
                            <td>@hour.Date.ToString("dd MMM yyyy")</td>
                            <td>@(hour.User?.FullName ?? "—")</td>
                            <td>@hour.Hours.ToString("N1")</td>
                            <td><span class="badge-status @(hour.Approved ? "status-approved" : "status-submitted")">@(hour.Approved ? "Approved" : "Pending")</span></td>
                        </tr>
                    }
                    @if (visibleHours.Count == 0)
                    {
                        <tr><td colspan="4" class="empty-state">No hours recorded for this programme.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
