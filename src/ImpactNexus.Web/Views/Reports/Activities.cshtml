@model List<ActivityReportRow>
@{
    ViewData["Title"] = "CSR activity report";
    var filters = (ReportFilters)ViewBag.Filters;
    var companies = (List<Company>)ViewBag.Companies;
    bool isInvestor = User.IsInRole(Roles.Investor);
    var route = new Dictionary<string, string?>
    {
        ["from"] = filters.From?.ToString("yyyy-MM-dd"),
        ["to"] = filters.To?.ToString("yyyy-MM-dd"),
        ["companyId"] = filters.CompanyId?.ToString(),
        ["status"] = filters.Status,
        ["search"] = filters.Search,
        ["export"] = "true"
    };
}
<div class="page-actions">
    <a class="btn btn-outline-secondary" asp-action="Index">Reports</a>
    <div class="ms-auto text-muted" style="font-size:.84rem;">@Model.Count record(s) · budget total <strong>@(((decimal)ViewBag.TotalBudget).ToString("C0", Money.Zar))</strong></div>
</div>
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="filters mb-0">
            <input type="date" name="from" value="@filters.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="From date" />
            <input type="date" name="to" value="@filters.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="To date" />
            <select name="companyId" class="form-select form-select-sm">
                <option value="">All companies</option>
                @foreach (var company in companies)
                {
                    <option value="@company.Id" selected="@(filters.CompanyId == company.Id)">@company.Name</option>
                }
            </select>
            <select name="status" class="form-select form-select-sm">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetNames<ActivityStatus>())
                {
                    <option value="@status" selected="@(filters.Status == status)">@status</option>
                }
            </select>
            <input type="text" name="search" value="@filters.Search" class="form-control form-control-sm" placeholder="Search" />
            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Activities" asp-all-route-data="route">Export CSV</a>
        </form>
    </div>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Activity</th><th>Company</th><th>Location</th><th>Start</th><th>End</th><th>Status</th><th>Indicator</th><th class="text-end">Budget</th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td><a asp-controller="Activities" asp-action="Details" asp-route-id="@row.Id">@row.Title</a></td>
                    <td>@row.Company</td>
                    <td>@row.Location</td>
                    <td>@row.StartDate.ToString("dd MMM yyyy")</td>
                    <td>@(row.EndDate?.ToString("dd MMM yyyy") ?? "—")</td>
                    <td><span class="badge-status status-@row.Status.ToLowerInvariant()">@row.Status</span></td>
                    <td>@(string.IsNullOrEmpty(row.ImpactIndicator) ? "—" : row.ImpactIndicator)</td>
                    <td class="text-end">@row.Budget.ToString("C0", Money.Zar)</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="empty-state">No activities match the selected filters.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
