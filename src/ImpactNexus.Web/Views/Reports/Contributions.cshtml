@model List<CompanyContributionReportRow>
@{
    ViewData["Title"] = "Company contribution report";
    var filters = (ReportFilters)ViewBag.Filters;
    var companies = (List<Company>)ViewBag.Companies;
    var route = new Dictionary<string, string?>
    {
        ["from"] = filters.From?.ToString("yyyy-MM-dd"),
        ["to"] = filters.To?.ToString("yyyy-MM-dd"),
        ["companyId"] = filters.CompanyId?.ToString(),
        ["export"] = "true"
    };
}
<div class="page-actions">
    <a class="btn btn-outline-secondary" asp-action="Index">Reports</a>
    <div class="ms-auto text-muted" style="font-size:.84rem;">Total received <strong>@(((decimal)ViewBag.Total).ToString("C0", Money.Zar))</strong></div>
</div>
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="filters mb-0">
            <input type="date" name="from" value="@filters.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="From date" />
            <input type="date" name="to" value="@filters.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="To date" />
            <select name="companyId" class="form-select form-select-sm">
                <option value="">All companies</option>
                @foreach (var company in companies)
                {
                    <option value="@company.Id" selected="@(filters.CompanyId == company.Id)">@company.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Contributions" asp-all-route-data="route">Export CSV</a>
        </form>
    </div>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Company</th><th class="text-end">Contributions</th><th class="text-end">Total</th><th>Last contribution</th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.Company</td>
                    <td class="text-end">@row.DonationCount</td>
                    <td class="text-end">@row.Total.ToString("C2", Money.Zar)</td>
                    <td>@(row.LastDonationOn?.ToString("dd MMM yyyy") ?? "—")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="empty-state">No contributions match the selected filters.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
