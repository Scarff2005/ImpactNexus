@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><h2>Change password</h2></div>
            <div class="card-body">
                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Minimum 8 characters with upper case, lower case, a digit and a symbol.</div>
                        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Update password</button>
                    <a class="btn btn-outline-secondary" asp-action="Profile">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
