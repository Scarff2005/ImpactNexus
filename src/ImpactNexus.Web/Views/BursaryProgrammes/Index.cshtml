@model List<BursaryProgramme>
@{
    ViewData["Title"] = "Bursary programmes";
}
<div class="page-actions">
    <a class="btn btn-primary" asp-action="Create">New programme</a>
    <form method="get" class="filters mb-0 ms-auto">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search programme" />
        <select name="active" class="form-select form-select-sm">
            <option value="">All</option>
            <option value="true" selected="@(ViewBag.Active as bool? == true)">Active</option>
            <option value="false" selected="@(ViewBag.Active as bool? == false)">Inactive</option>
        </select>
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </form>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Programme</th><th>Company</th><th>Year</th><th>Window</th><th>Status</th><th class="text-end">Budget</th></tr></thead>
            <tbody>
            @foreach (var programme in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@programme.Id">@programme.Name</a></td>
                    <td>@programme.Company?.Name</td>
                    <td>@programme.AcademicYear</td>
                    <td>@programme.OpenDate.ToString("dd MMM") – @programme.CloseDate.ToString("dd MMM yyyy")</td>
                    <td><span class="badge-status @(programme.IsAcceptingApplications ? "status-active" : "status-cancelled")">@(programme.IsAcceptingApplications ? "Accepting" : programme.IsActive ? "Window closed" : "Inactive")</span></td>
                    <td class="text-end">@programme.Budget.ToString("C0", Money.Zar)</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="empty-state"><strong>No bursary programmes</strong>Create a programme to start accepting applications.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
