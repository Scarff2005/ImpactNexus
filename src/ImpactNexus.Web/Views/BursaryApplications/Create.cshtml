@model BursaryApplication
@{
    ViewData["Title"] = "Capture bursary application";
    var programmes = (List<BursaryProgramme>)ViewBag.Programmes;
    var beneficiaries = (List<Beneficiary>)ViewBag.Beneficiaries;
}
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="BursaryProgrammeId" class="form-label"></label>
                    <select asp-for="BursaryProgrammeId" class="form-select">
                        <option value="">Select programme</option>
                        @foreach (var programme in programmes)
                        {
                            <option value="@programme.Id">@programme.Name (@programme.AcademicYear)</option>
                        }
                    </select>
                    <span asp-validation-for="BursaryProgrammeId" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BeneficiaryId" class="form-label"></label>
                    <select asp-for="BeneficiaryId" class="form-select">
                        <option value="">Select beneficiary</option>
                        @foreach (var beneficiary in beneficiaries)
                        {
                            <option value="@beneficiary.Id">@beneficiary.FullName</option>
                        }
                    </select>
                    <span asp-validation-for="BeneficiaryId" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        @foreach (var status in Enum.GetValues<BursaryApplicationStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AmountAwarded" class="form-label"></label>
                    <input asp-for="AmountAwarded" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="AmountAwarded" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AppliedOn" class="form-label"></label>
                    <input asp-for="AppliedOn" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Motivation" class="form-label"></label>
                    <textarea asp-for="Motivation" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Motivation" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ReviewNotes" class="form-label"></label>
                    <textarea asp-for="ReviewNotes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save application</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
