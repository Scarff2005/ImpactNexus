@model BursaryApplication
@{
    ViewData["Title"] = "Bursary application";
    bool canManage = User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.CsrManager);
}
<div class="page-actions">
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    @if (canManage)
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Review</a>
        <a class="btn btn-outline-danger ms-auto" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    }
</div>
<div class="card">
    <div class="card-body">
        <dl class="detail-list">
            <dt>Applicant</dt><dd>@Model.Beneficiary?.FullName</dd>
            <dt>Programme</dt><dd>@Model.BursaryProgramme?.Name</dd>
            <dt>Company</dt><dd>@Model.BursaryProgramme?.Company?.Name</dd>
            <dt>Academic year</dt><dd>@Model.BursaryProgramme?.AcademicYear</dd>
            <dt>Applied</dt><dd>@Model.AppliedOn.ToString("dd MMM yyyy")</dd>
            <dt>Status</dt><dd><span class="badge-status status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></dd>
            <dt>Amount awarded</dt><dd>@(Model.AmountAwarded?.ToString("C0", Money.Zar) ?? "—")</dd>
            <dt>Decision date</dt><dd>@(Model.DecisionOn?.ToString("dd MMM yyyy") ?? "—")</dd>
            <dt>Motivation</dt><dd>@Model.Motivation</dd>
            <dt>Review notes</dt><dd>@(Model.ReviewNotes ?? "—")</dd>
        </dl>
    </div>
</div>
