@model BursaryApplication
@{
    ViewData["Title"] = "Review bursary application";
}
<div class="card">
    <div class="card-body">
        <p class="text-muted">Reviewing the application from <strong>@Model.Beneficiary?.FullName</strong> for <strong>@Model.BursaryProgramme?.Name</strong>.</p>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="BursaryProgrammeId" />
            <input type="hidden" asp-for="BeneficiaryId" />
            <input type="hidden" asp-for="Motivation" />
            <input type="hidden" asp-for="AppliedOn" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        @foreach (var status in Enum.GetValues<BursaryApplicationStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AmountAwarded" class="form-label"></label>
                    <input asp-for="AmountAwarded" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="AmountAwarded" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DecisionOn" class="form-label"></label>
                    <input asp-for="DecisionOn" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="ReviewNotes" class="form-label"></label>
                    <textarea asp-for="ReviewNotes" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save review</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
