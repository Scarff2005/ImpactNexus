@model Province
@{
    ViewData["Title"] = "Delete province";
}
<div class="card">
    <div class="card-body">
        <p>Delete <strong>@Model.Name</strong>? Provinces with towns cannot be deleted.</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this province?">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Delete province</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
