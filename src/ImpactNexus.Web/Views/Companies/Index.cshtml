@model List<Company>
@{
    ViewData["Title"] = "Companies";
    bool isAdmin = User.IsInRole(Roles.Administrator);
}
<div class="page-actions">
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">Register company</a>
    }
    <form method="get" class="filters mb-0 ms-auto">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search company" />
        <select name="active" class="form-select form-select-sm">
            <option value="">All</option>
            <option value="true" selected="@(ViewBag.Active as bool? == true)">Active</option>
            <option value="false" selected="@(ViewBag.Active as bool? == false)">Inactive</option>
        </select>
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </form>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Company</th><th>Registration</th><th>Country</th><th>Contact</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var company in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@company.Id">@company.Name</a>
                        <div class="text-muted" style="font-size:.74rem;">@company.Industry</div>
                    </td>
                    <td>@(company.RegistrationNumber ?? "—")</td>
                    <td>@(company.Country?.Name ?? "—")</td>
                    <td>@(company.Email ?? company.Phone ?? "—")</td>
                    <td>
                        <span class="badge-status @(company.IsActive ? "status-active" : "status-cancelled")">
                            @(company.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@company.Id">Open</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@company.Id">Edit</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="empty-state"><strong>No companies found</strong>Register a company to begin.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
