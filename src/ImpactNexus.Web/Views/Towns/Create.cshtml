@model Town
@{
    ViewData["Title"] = "Add town";
    var provinces = (List<Province>)ViewBag.Provinces;
}
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProvinceId" class="form-label"></label>
                    <select asp-for="ProvinceId" class="form-select">
                        <option value="">Select province</option>
                        @foreach (var province in provinces)
                        {
                            <option value="@province.Id">@province.Name (@province.Country?.Name)</option>
                        }
                    </select>
                    <span asp-validation-for="ProvinceId" class="field-validation-error"></span>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
