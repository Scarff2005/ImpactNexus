@model ManagerDashboardViewModel
@{
    ViewData["Title"] = "Company dashboard";
    ViewData["Subtitle"] = Model.Company.Name;
    var maxMonthly = Model.MonthlyContributions.Count == 0 ? 1m : Math.Max(1m, Model.MonthlyContributions.Max(m => m.Amount));
    var totalStatus = Math.Max(1, Model.ActivityStatusBreakdown.Sum(s => s.Count));
}
<div class="kpi-grid">
    <div class="kpi">
        <div class="label">Activities</div>
        <div class="value">@Model.ActivityCount</div>
        <div class="hint">@Model.ActiveActivityCount currently in progress</div>
    </div>
    <div class="kpi kpi-alt">
        <div class="label">Programme budget</div>
        <div class="value">@Model.TotalBudget.ToString("C0", Money.Zar)</div>
        <div class="hint">Across all company activities</div>
    </div>
    <div class="kpi">
        <div class="label">Contributions received</div>
        <div class="value">@Model.ContributionTotal.ToString("C0", Money.Zar)</div>
        <div class="hint">Allocated and received donations</div>
    </div>
    <div class="kpi kpi-warn">
        <div class="label">Bursaries awarded</div>
        <div class="value">@Model.BursaryAwarded.ToString("C0", Money.Zar)</div>
        <div class="hint">@Model.OpenBursaryApplications open application(s)</div>
    </div>
    <div class="kpi kpi-rose">
        <div class="label">Volunteer hours</div>
        <div class="value">@Model.VolunteerHours.ToString("N1")</div>
        <div class="hint">@Model.VolunteerCount volunteer(s), @Model.BeneficiaryCount beneficiary record(s)</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header"><h2>Contributions, last six months</h2></div>
            <div class="card-body">
                <div class="spark-wrap">
                    <div class="spark">
                        @foreach (var point in Model.MonthlyContributions)
                        {
                            var height = Math.Max(4, (int)(point.Amount / maxMonthly * 100));
                            <div class="bar" style="height:@height%" title="@point.Label: @point.Amount.ToString("C0", Money.Zar)">
                                <span>@point.Label</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2>Recent activities</h2>
                <a class="btn btn-sm btn-primary" asp-controller="Activities" asp-action="Create">New activity</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Activity</th><th>Dates</th><th>Status</th><th class="text-end">Budget</th></tr></thead>
                    <tbody>
                    @foreach (var activity in Model.RecentActivities)
                    {
                        <tr>
                            <td><a asp-controller="Activities" asp-action="Details" asp-route-id="@activity.Id">@activity.Title</a></td>
                            <td>@activity.StartDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge-status status-@activity.Status.ToString().ToLowerInvariant()">@activity.Status</span></td>
                            <td class="text-end">@activity.Budget.ToString("C0", Money.Zar)</td>
                        </tr>
                    }
                    @if (Model.RecentActivities.Count == 0)
                    {
                        <tr><td colspan="4" class="empty-state">Start by creating a CSR activity for your company.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header"><h2>Activity status mix</h2></div>
            <div class="card-body">
                @if (Model.ActivityStatusBreakdown.Count == 0)
                {
                    <p class="text-muted mb-0" style="font-size:.86rem;">No activities to summarise.</p>
                }
                else
                {
                    <div class="legend flex-column gap-2">
                        @foreach (var status in Model.ActivityStatusBreakdown)
                        {
                            var pct = (int)Math.Round(status.Count * 100.0 / totalStatus);
                            <div class="w-100">
                                <div class="d-flex justify-content-between">
                                    <span>@status.Status</span><span>@status.Count (@pct%)</span>
                                </div>
                                <div class="progress mt-1" style="height:6px;">
                                    <div class="progress-bar bg-info" style="width:@pct%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h2>Recent contributions</h2></div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Donor</th><th>Date</th><th class="text-end">Amount</th></tr></thead>
                    <tbody>
                    @foreach (var donation in Model.RecentDonations)
                    {
                        <tr>
                            <td><a asp-controller="Donations" asp-action="Details" asp-route-id="@donation.Id">@donation.DonorName</a></td>
                            <td>@donation.DonatedOn.ToString("dd MMM")</td>
                            <td class="text-end">@donation.Amount.ToString("C0", Money.Zar)</td>
                        </tr>
                    }
                    @if (Model.RecentDonations.Count == 0)
                    {
                        <tr><td colspan="3" class="empty-state">No contributions recorded yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-body d-grid gap-2">
                <a class="btn btn-primary" asp-controller="Reports" asp-action="Activities">Company activity report</a>
                <a class="btn btn-outline-primary" asp-controller="BursaryApplications" asp-action="Index">Review bursary applications</a>
                <a class="btn btn-outline-secondary" asp-controller="VolunteerHours" asp-action="Index">Approve volunteer hours</a>
            </div>
        </div>
    </div>
</div>
