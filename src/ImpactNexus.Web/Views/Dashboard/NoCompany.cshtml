@{
    ViewData["Title"] = "Account not configured";
}
<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><h2>Company not assigned</h2></div>
            <div class="card-body">
                <p class="mb-3">
                    Your account has the <strong>CSR Manager</strong> role but is not linked to a company,
                    so there is nothing to show here yet.
                </p>
                <p class="text-muted mb-0">
                    Ask the IT administrator to assign you to a company under
                    <strong>Users &rarr; Edit</strong>. The change takes effect within a minute of being saved.
                </p>
            </div>
        </div>
    </div>
</div>
