@model PagedList<Beneficiary>
@{
    ViewData["Title"] = "Beneficiaries";
}
<div class="page-actions">
    <a class="btn btn-primary" asp-action="Create">Add beneficiary</a>
    <form method="get" class="filters mb-0 ms-auto">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search name or email" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </form>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Name</th><th>Email</th><th>Town</th><th>Company</th><th>Applications</th><th></th></tr></thead>
            <tbody>
            @foreach (var beneficiary in Model.Items)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@beneficiary.Id">@beneficiary.FullName</a></td>
                    <td>@(beneficiary.Email ?? "—")</td>
                    <td>@(beneficiary.Town?.Name ?? "—")</td>
                    <td>@(beneficiary.Company?.Name ?? "—")</td>
                    <td>@beneficiary.Applications.Count</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@beneficiary.Id">Edit</a></td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="empty-state"><strong>No beneficiaries</strong>Add a beneficiary to begin tracking outcomes.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="PagerModel.From(Model)" />
</div>
